# Copy to .env and fill every value before ./scripts/start.sh
#   openssl rand -base64 32

POSTGRES_PASSWORD=
REDIS_PASSWORD=

# At least 32 characters
JWT_SECRET_KEY=

# Exactly 32 UTF-8 characters, or 32-byte base64
ENCRYPTION_KEK=

# First admin password; must be changed at first login
ADMIN_PASSWORD=

# Optional: private Ethereum operator key (Anvil default is used locally)
ETHEREUM_PRIVATE_KEY=

# Optional: container registry for CI
REGISTRY_URL=
REGISTRY_USERNAME=
REGISTRY_TOKEN=
