# PostgreSQL
POSTGRES_PASSWORD=ChangeMe123!

# Redis
REDIS_PASSWORD=RedisPass123!

# MongoDB
MONGO_USER=admin
MONGO_PASSWORD=MongoPass123!

# RabbitMQ
RABBITMQ_USER=admin
RABBITMQ_PASS=RabbitPass123!

# JWT Settings (Generate strong secret keys in production)
JWT_SECRET_KEY=YourSuperSecretKeyMinimum32CharactersLongForHS256!

# SSL/TLS Certificates (for Nginx HTTPS)
SSL_CERT_PATH=./infrastructure/nginx/ssl/cert.pem
SSL_KEY_PATH=./infrastructure/nginx/ssl/key.pem

