{
  "ConnectionStrings": {
    "PostgreSQL": "Host=localhost;Port=5433;Database=secureboxdb;Username=securebox_user;Password=",
    "Redis": "localhost:6380"
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "SecureBoxAPI",
    "Audience": "SecureBoxPortal",
    "AccessTokenExpirationMinutes": 15,
    "RefreshTokenExpirationDays": 7
  },
  "Encryption": {
    "KeyEncryptionKey": ""
  },
  "Database": {
    "ApplyMigrationsOnStartup": true,
    "SeedDefaultsOnStartup": true,
    "DefaultAdminPassword": ""
  },
  "AllowedOrigins": [
    "https://localhost",
    "https://127.0.0.1",
    "http://localhost:4200"
  ],
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
